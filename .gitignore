# Quarto build output
/_site/
/.quarto/
*_files/
/site_libs/
# Conflict copies ("name 2") that a synced folder such as iCloud Drive creates.
*_files */

# Generated by R/build_modules.R from content/modules.yml on every build (CI
# runs it as its own step, see publish.yml). Never edited by hand.
/modules/module-01*.qmd
/modules/module-02*.qmd
/modules/module-03*.qmd
/assets/pen-manifest.html

# Media. The final .mp4 files in videos/ are committed and published with the
# site. The raw caption exports next to them (input to
# scripts/prepare_captions.py) stay local; the cleaned captions and
# transcripts in assets/captions/ and transcripts/ belong in the repo.
/videos/**/*.vtt
*.mov
*.m4v
*.webm
*.avi

# R
.Rproj.user/
.Rhistory
.RData
.Ruserdata

# OS / editor
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/
